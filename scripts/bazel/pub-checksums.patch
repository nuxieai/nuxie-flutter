+# Nuxie: relocate only declared path dependencies in this private workspace.
+# Flutter's analyzer validates pubspec paths separately from package_config.
+def _relocate_path_dependencies():
+    import json
+    paths = {
+        entry["name"]: os.path.join(cache_root, "hosted", "pub.dev", entry["name"] + "-" + entry["version"])
+        for entry in data.get("packages", [])
+        if entry.get("source") == "path" and entry.get("name") and entry.get("version")
+    }
+    pubspec = os.path.join(workspace_root, "pubspec.yaml")
+    if not paths or not os.path.isfile(pubspec):
+        return
+    with open(pubspec, encoding="utf-8") as stream:
+        lines = stream.readlines()
+    section = None
+    dependency = None
+    for index, line in enumerate(lines):
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip(" "))
+        if indent == 0:
+            section = stripped[:-1] if stripped.endswith(":") else None
+            dependency = None
+        elif section in ("dependencies", "dev_dependencies", "dependency_overrides"):
+            if indent == 2:
+                dependency = stripped[:-1] if stripped.endswith(":") else None
+            elif indent == 4 and dependency in paths and stripped.startswith("path:"):
+                destination = paths[dependency]
+                if not os.path.isdir(destination):
+                    raise ValueError("Declared path dependency was not staged: " + dependency)
+                lines[index] = "    path: " + json.dumps(destination) + "\\n"
+    with open(pubspec, "w", encoding="utf-8") as stream:
+        stream.writelines(lines)
+
+_relocate_path_dependencies()
+# End Nuxie path relocation.
