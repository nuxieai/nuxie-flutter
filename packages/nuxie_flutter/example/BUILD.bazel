load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test", "flutter_analyze_test")

package(default_visibility = ["//visibility:public"])

flutter_library(
    name = "lib",
    srcs = glob(["lib/**"]) + ["analysis_options.yaml"],
    pubspec = "pubspec.yaml",
    pub_deps = "pub_deps.json",
    deps = [
        "@flutter_sdk//flutter/packages/flutter",
        "//packages/nuxie_flutter:package",
        "@pub_cupertino_icons//:cupertino_icons",
        "@flutter_sdk//flutter/packages/integration_test",
        "@flutter_sdk//flutter/packages/flutter_test",
        "@pub_flutter_lints//:flutter_lints",
        # The example's owning lock selects newer versions than the Flutter
        # SDK's integration_test seed. Keep those declared package edges.
        "@pub_process//:process",
        "@pub_webdriver//:webdriver",
    ],
)

flutter_test(name = "unit_tests", srcs = glob(["test/**"]), embed = [":lib"], jobs = 2)
flutter_analyze_test(name = "analyze", srcs = glob(["test/**"]), embed = [":lib"])
exports_files(["pub_deps.json"])
