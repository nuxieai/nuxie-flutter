module(name = "nuxie_flutter")

bazel_dep(name = "rules_flutter", version = "0.0.0")
git_override(
    module_name = "rules_flutter",
    remote = "https://github.com/SpencerC/rules_flutter.git",
    commit = "32b34b2cfe6dbd3bfa5c98e740b386e0126004ff",
    patches = ["//scripts/bazel:pub-checksums.patch"],
    patch_strip = 1,
)
flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.41.4", precache = ["ios", "android"])
use_repo(flutter, "flutter_sdk", "flutter_toolchains")
register_toolchains("@flutter_toolchains//:all")

pub = use_extension("@rules_flutter//flutter:extensions.bzl", "pub")
pub.from_file(pub_deps = "//packages/nuxie_flutter_platform_interface:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
pub.from_file(pub_deps = "//packages/nuxie_flutter_native:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
pub.from_file(pub_deps = "//packages/nuxie_flutter:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
pub.from_file(pub_deps = "//packages/nuxie_flutter_bloc:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
pub.from_file(pub_deps = "//packages/nuxie_flutter_riverpod:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
pub.from_file(pub_deps = "//packages/nuxie_flutter/example:pub_deps.json", archive_hashes = "//scripts/bazel:pub-archives.json")
use_repo(pub,
    "pub__fe_analyzer_shared",
    "pub_analyzer",
    "pub_args",
    "pub_async",
    "pub_bloc",
    "pub_bloc_test",
    "pub_boolean_selector",
    "pub_built_collection",
    "pub_built_value",
    "pub_characters",
    "pub_cli_config",
    "pub_clock",
    "pub_code_builder",
    "pub_collection",
    "pub_convert",
    "pub_coverage",
    "pub_crypto",
    "pub_cupertino_icons",
    "pub_dart_style",
    "pub_diff_match_patch",
    "pub_fake_async",
    "pub_file",
    "pub_fixnum",
    "pub_flutter_lints",
    "pub_frontend_server_client",
    "pub_glob",
    "pub_graphs",
    "pub_http_multi_server",
    "pub_http_parser",
    "pub_io",
    "pub_leak_tracker",
    "pub_leak_tracker_flutter_testing",
    "pub_leak_tracker_testing",
    "pub_lints",
    "pub_logging",
    "pub_matcher",
    "pub_material_color_utilities",
    "pub_meta",
    "pub_mime",
    "pub_mocktail",
    "pub_node_preamble",
    "pub_package_config",
    "pub_path",
    "pub_pigeon",
    "pub_platform",
    "pub_plugin_platform_interface",
    "pub_pool",
    "pub_process",
    "pub_pub_semver",
    "pub_riverpod",
    "pub_shelf",
    "pub_shelf_packages_handler",
    "pub_shelf_static",
    "pub_shelf_web_socket",
    "pub_source_map_stack_trace",
    "pub_source_maps",
    "pub_source_span",
    "pub_stack_trace",
    "pub_state_notifier",
    "pub_stream_channel",
    "pub_string_scanner",
    "pub_sync_http",
    "pub_term_glyph",
    "pub_test",
    "pub_test_api",
    "pub_test_core",
    "pub_typed_data",
    "pub_vector_math",
    "pub_vm_service",
    "pub_watcher",
    "pub_web",
    "pub_web_socket",
    "pub_web_socket_channel",
    "pub_webdriver",
    "pub_webkit_inspection_protocol",
    "pub_yaml",
